// Legado Cumbiero — esquema de datos (Postgres).
// Reemplaza a src/lib/db.ts (SQLite) del monorepo Next.js: éste es ahora
// el dueño de todos los datos de la plataforma (tenants, shows, reservas,
// listas de invitados) más usuarios/roles/permisos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  TENANT_STAFF
  CUSTOMER
}

/// Categorías de permiso asignables a un TENANT_STAFF por su TENANT_ADMIN.
/// TENANT_ADMIN tiene todo esto implícito dentro de su propio tenant, sin
/// necesitar filas en StaffPermission.
enum PermissionKey {
  SHOWS_MANAGE
  RESERVATIONS_MANAGE
  GUEST_LIST_MANAGE
  TENANT_SETTINGS_MANAGE
}

enum GuestStatus {
  pendiente
  confirmado
  ingreso
}

enum ReservationStatus {
  confirmada
  cancelada
}

model Tenant {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  city        String
  description String   @default("")
  accentColor String   @default("#E9376F")
  amenities   String[] @default(["Bailable", "Bar"])
  createdAt   DateTime @default(now())

  users        User[]
  artists      Artist[]
  shows        Show[]
  guestEntries GuestListEntry[]
  reservations Reservation[]

  @@map("Tenant")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  staffPermissions StaffPermission[]

  @@map("User")
}

/// Refresh token opaco (no JWT): sólo se guarda el hash, nunca el valor
/// crudo. `family` agrupa la cadena de reemisiones por rotación — si se
/// detecta el uso de un token ya reemplazado, se revoca toda la familia
/// (señal de robo).
model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  family              String
  replacedByTokenHash String?
  revokedAt           DateTime?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  userAgent           String?
  ip                  String?

  @@index([userId])
  @@index([family])
  @@map("RefreshToken")
}

model StaffPermission {
  id     String        @id @default(uuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    PermissionKey

  @@unique([userId, key])
  @@map("StaffPermission")
}

model Artist {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  genre    String @default("Cumbia")

  lineup ShowArtist[]

  @@index([tenantId])
  @@map("Artist")
}

model Show {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime
  capacity    Int      @default(200)
  ticketPrice Int      @default(0)

  lineup       ShowArtist[]
  reservations Reservation[]
  guestEntries GuestListEntry[]

  @@index([tenantId])
  @@index([date])
  @@map("Show")
}

model ShowArtist {
  id       String  @id @default(uuid())
  showId   String
  show     Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  artistId String
  artist   Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  slotTime String?

  @@index([showId])
  @@map("ShowArtist")
}

model GuestListEntry {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  showId    String
  show      Show        @relation(fields: [showId], references: [id], onDelete: Cascade)
  name      String
  plusOnes  Int         @default(0)
  status    GuestStatus @default(pendiente)
  createdAt DateTime    @default(now())

  @@index([tenantId])
  @@index([showId])
  @@map("GuestListEntry")
}

model Reservation {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  showId        String
  show          Show              @relation(fields: [showId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  quantity      Int               @default(1)
  status        ReservationStatus @default(confirmada)
  createdAt     DateTime          @default(now())

  @@index([tenantId])
  @@index([showId])
  @@map("Reservation")
}
