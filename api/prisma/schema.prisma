// Legado Cumbiero — esquema de datos (Postgres).
// Reemplaza a src/lib/db.ts (SQLite) del monorepo Next.js: éste es ahora
// el dueño de todos los datos de la plataforma (tenants, shows, reservas,
// listas de invitados) más usuarios/roles/permisos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  TENANT_STAFF
  CUSTOMER
}

/// Categorías de permiso asignables a un TENANT_STAFF por su TENANT_ADMIN.
/// TENANT_ADMIN tiene todo esto implícito dentro de su propio tenant, sin
/// necesitar filas en StaffPermission.
enum PermissionKey {
  SHOWS_MANAGE
  RESERVATIONS_MANAGE
  GUEST_LIST_MANAGE
  TENANT_SETTINGS_MANAGE
}

enum GuestStatus {
  pendiente
  confirmado
  ingreso
}

enum ReservationStatus {
  confirmada
  cancelada
}

model Tenant {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  /// Nombre de ciudad resuelto y desnormalizado (evita joinear Province/City
  /// en cada listado público). provinceId/cityId son sólo para precargar el
  /// selector al editar.
  city        String
  provinceId  String?
  province    Province? @relation(fields: [provinceId], references: [id])
  cityId      String?
  cityRef     City?     @relation(fields: [cityId], references: [id])
  description String   @default("")
  accentColor String   @default("#E9376F")
  amenities   String[] @default(["Bailable", "Bar"])
  /// Ruta pública (/uploads/tenants/<id>/...) — null hasta que se suba una.
  logoUrl       String?
  coverImageUrl String?
  /// Info de contacto/operativa — todo opcional, se completa desde el panel.
  address       String?
  contactPhone  String?
  instagram     String?
  openingHours  String?
  minAge        Int?
  /// Desactivar = "borrar" reversible: desaparece de la app pública sin
  /// tocar sus shows/reservas/invitados/staff.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users        User[]
  artists      Artist[]
  shows        Show[]
  guestEntries GuestListEntry[]
  reservations Reservation[]
  favoritedBy  Favorite[]

  @@index([provinceId])
  @@index([cityId])
  @@map("Tenant")
}

model Province {
  id        String   @id // id de Georef, ej "06"
  name      String
  cities    City[]
  tenants   Tenant[]
  users     User[]
  updatedAt DateTime @updatedAt

  @@map("Province")
}

model City {
  id         String   @id // id de Georef (municipio)
  name       String
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  tenants    Tenant[]
  users      User[]

  @@index([provinceId])
  @@map("City")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  /// Sólo se usan hoy en el registro de CUSTOMER — cuentas de staff/admin
  /// creadas desde los paneles no las piden (no aportan a reportes de
  /// clientes) y quedan null.
  phoneAreaCode String?
  phoneNumber   String?
  birthDate     DateTime? @db.Date
  provinceId    String?
  province      Province? @relation(fields: [provinceId], references: [id])
  cityId        String?
  cityRef       City?     @relation(fields: [cityId], references: [id])
  /// Opt-in explícito para poder usar email/WhatsApp en campañas — false
  /// por default, nunca se asume.
  marketingOptIn Boolean @default(false)
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  staffPermissions StaffPermission[]
  reservations     Reservation[]
  favorites        Favorite[]

  @@index([provinceId])
  @@index([cityId])
  @@map("User")
}

/// Boliches marcados como favoritos por un CUSTOMER — alimenta "Tus
/// favoritos" en /perfil.
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("Favorite")
}

/// Refresh token opaco (no JWT): sólo se guarda el hash, nunca el valor
/// crudo. `family` agrupa la cadena de reemisiones por rotación — si se
/// detecta el uso de un token ya reemplazado, se revoca toda la familia
/// (señal de robo).
model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  family              String
  replacedByTokenHash String?
  revokedAt           DateTime?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  userAgent           String?
  ip                  String?

  @@index([userId])
  @@index([family])
  @@map("RefreshToken")
}

model StaffPermission {
  id     String        @id @default(uuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    PermissionKey

  @@unique([userId, key])
  @@map("StaffPermission")
}

model Artist {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  genre    String @default("Cumbia")

  lineup ShowArtist[]

  @@index([tenantId])
  @@map("Artist")
}

model Show {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime
  capacity    Int      @default(200)
  ticketPrice Int      @default(0)
  /// Desactivar = "borrar" reversible: desaparece de los listados públicos.
  isActive    Boolean  @default(true)

  lineup       ShowArtist[]
  reservations Reservation[]
  guestEntries GuestListEntry[]

  @@index([tenantId])
  @@index([date])
  @@map("Show")
}

model ShowArtist {
  id       String  @id @default(uuid())
  showId   String
  show     Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  artistId String
  artist   Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  slotTime String?

  @@index([showId])
  @@map("ShowArtist")
}

model GuestListEntry {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  showId    String
  show      Show        @relation(fields: [showId], references: [id], onDelete: Cascade)
  name      String
  plusOnes  Int         @default(0)
  status    GuestStatus @default(pendiente)
  createdAt DateTime    @default(now())

  @@index([tenantId])
  @@index([showId])
  @@map("GuestListEntry")
}

model Reservation {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  showId        String
  show          Show              @relation(fields: [showId], references: [id], onDelete: Cascade)
  /// Quién reservó. Nullable sólo por datos históricos migrados del checkout
  /// de invitado viejo (sin cuenta) — el endpoint de creación actual siempre
  /// lo completa, porque reservar ahora exige estar logueado.
  userId        String?
  user          User?             @relation(fields: [userId], references: [id])
  customerName  String
  customerPhone String
  quantity      Int               @default(1)
  status        ReservationStatus @default(confirmada)
  createdAt     DateTime          @default(now())

  @@index([tenantId])
  @@index([showId])
  @@index([userId])
  @@map("Reservation")
}
