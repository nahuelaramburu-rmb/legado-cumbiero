# Copiar a .env y completar. En la VPS estos valores viven en el .env real
# (no versionado) junto al docker-compose.yml.

# Postgres
POSTGRES_USER=legado
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=legado
DATABASE_URL=postgresql://legado:cambiar-esto@localhost:5432/legado

# JWT — generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambiar-esto
JWT_REFRESH_SECRET=cambiar-esto
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — orígenes del/los frontend(s) que consumen la API directamente
# (server-to-server desde Next.js no pasa por CORS)
CORS_ORIGIN=https://legadocumbiero.rmbcorp.com

PORT=3000
