# Copiar a .env.local y completar para desarrollo local.
# En producción (VPS) estas mismas variables se setean en docker-compose.yml
# (API_INTERNAL_URL fija) + el .env de la raíz (JWT_ACCESS_SECRET).

# URL de la API interna. En Docker es http://legado-api:3000/api/v1 (nombre
# del servicio); en local, si corrés `npm run start:dev` dentro de api/ con
# PORT=3001, o si usás un túnel SSH hacia la API real de la VPS.
API_INTERNAL_URL=http://localhost:3001/api/v1

# Tiene que ser EXACTAMENTE el mismo valor que JWT_ACCESS_SECRET en api/.env
# — Next.js verifica acá los tokens que emite la API.
JWT_ACCESS_SECRET=cambiar-esto
